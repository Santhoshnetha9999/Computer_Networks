import java.util.Scanner;
public class GoBack{
public static void main(String[] santhosh){
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of frames: ");
        int n = sc.nextInt();

        System.out.print("Enter window size: ");
        int windowSize = sc.nextInt();

        System.out.print("Enter frame number to simulate loss (-1 for no loss): ");
        int lostFrame = sc.nextInt();

        int base = 0;

        while (base < n) {
            int end = Math.min(base + windowSize, n);

            System.out.println("\nSending frames " + base + " to " + (end - 1));

            boolean error = false;

            for (int i = base; i < end; i++) {
                System.out.println("Sending Frame " + i);

                if (i == lostFrame) {
                    System.out.println("Frame " + i + " lost!");
                    error = true;
                    break;
                }

                System.out.println("ACK received for Frame " + i);
            }

            if (error) {
                System.out.println("\nTimeout occurred for Frame " + lostFrame);
                System.out.println("Go-Back-N: Retransmitting from Frame " + lostFrame);

                base = lostFrame;
                lostFrame = -1; // Simulate successful retransmission
            } else {
                base = end;
            }
        }

        System.out.println("\nAll frames transmitted successfully.");
        sc.close();

}
}
