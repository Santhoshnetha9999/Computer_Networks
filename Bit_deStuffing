import java.util.Scanner;

public class BitDestuffing {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter stuffed bit string: ");
        String bits = sc.nextLine();

        StringBuilder result = new StringBuilder();
        int count = 0;

        for (int i = 0; i < bits.length(); i++) {
            char bit = bits.charAt(i);

            result.append(bit);

            if (bit == '1') {
                count++;

                // After five consecutive 1s, skip the stuffed 0
                if (count == 5 && i + 1 < bits.length()
                        && bits.charAt(i + 1) == '0') {
                    i++;       // Skip stuffed 0
                    count = 0;
                }
            } else {
                count = 0;
            }
        }

        System.out.println("Destuffed data: " + result);

        sc.close();
    }
}
